{
	"name": "@toolmate/core",
	"description": "Framework for editors.",
	"version": "1.0.0",
	"author": "Anatoly Voevodin",
	"license": "AGPL-3.0",
	"keywords": [
		"editor",
		"framework",
		"tool",
		"tooling",
		"viewer"
	],
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": "./dist/main.js",
		"./style": "./dist/assets/style.css"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepublishOnly": "npm run lint && npm run build",
		"build": "tsc --p ./tsconfig-build.json && vite build",
		"preview": "vite preview",
		"lint": "prettier --check . && eslint . && tsc --p ./tsconfig-build.json --noEmit",
		"prettify": "prettier --write .",
		"release": "release-it"
	},
	"dependencies": {
		"@kobalte/core": "^0.13.14",
		"solid-js": "^1.9.18"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-solid": "^0.19.0",
		"prettier": "^3.9.10",
		"release-it": "^21.1.2",
		"sass": "^1.108.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"vite-plugin-dts": "^5.1.2",
		"vite-plugin-solid": "^2.11.15"
	},
	"homepage": "https://github.com/anvoevodin/toolmate-core",
	"url": "https://github.com/anvoevodin/toolmate-core",
	"repository": {
		"type": "git",
		"url": "https://github.com/anvoevodin/toolmate-core.git"
	},
	"bugs": {
		"url": "https://github.com/anvoevodin/toolmate-core/issues"
	},
	"publishConfig": {
		"access": "public"
	}
}
